# Copy to .env and fill in. Never commit .env — it holds the key that
# decrypts every business's Gemini credential.

PORT=4000

# Mongo connection string for this service's own database.
MONGODB_URI=mongodb://127.0.0.1:27017/rebuzz_ai

# 32 bytes, hex-encoded (64 characters). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Rotating this makes every stored key undecryptable, so store it somewhere
# durable before the first write. In production prefer AI_ENCRYPTION_KEY_FILE
# (a path to a file holding the hex) so the key never sits in `env` output —
# e.g. Docker secrets or a K8s secret volume. AI_ENCRYPTION_KEY_FILE wins
# when both are set.
AI_ENCRYPTION_KEY=
# AI_ENCRYPTION_KEY_FILE=/run/secrets/ai_encryption_key

# The existing POS API. This service does not own auth, so it asks that API
# who a token belongs to before trusting it.
POS_API_URL=https://api.beta.rebuzzpos.com/api

# Where the frontend runs, for CORS.
#
# Only consulted if a browser calls this service directly. Today it does not:
# the Next.js route at app/api/settings/ai/ forwards to here server-to-server,
# and a server-to-server fetch sends no Origin header, so CORS never applies.
# Set this in production anyway — the service refuses to boot with NODE_ENV=
# production and no CORS_ORIGIN, because the first browser-side call would
# otherwise be blocked with no obvious cause. If this service is provably
# never called by a browser, ALLOW_DEFAULT_CORS=true opts out of that check.
CORS_ORIGIN=http://localhost:3000
# ALLOW_DEFAULT_CORS=true
