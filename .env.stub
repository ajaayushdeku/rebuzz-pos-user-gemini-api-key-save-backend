# Loaded alongside .env by `npm run dev:stub` (Node takes several --env-file
# flags, which is also how this stays cross-platform — an inline VAR=1 prefix
# does not work in PowerShell or cmd).
#
# Every provider then answers from helpers/aiProviders/stub.js: no key is used,
# nothing is spent, and every insight is nonsense. app.js refuses to boot like
# this with NODE_ENV=production.
AI_STUB_PROVIDER=1
